# Copy to .env (root) — never commit .env
# --- Server ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# MOCK=1 => every route returns fixtures from server/src/mocks (no keys needed)
MOCK=1

OPENAI_API_KEY=
CHAT_MODEL=gpt-5-mini
BACKGROUND_MODEL=gpt-5-nano
RERANK_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
ELEVENLABS_API_KEY=
GITHUB_TOKEN=
DEMO_REPO=brightline-software/invoicing-service
# WARM_DEMO=1 => at start (and every 50 min) runs retrieval for server/data/demo-questions.json; set it on demo day
WARM_DEMO=
SLACK_WEBHOOK_URL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared password for the team + demo accounts (supabase/seed/team.mjs), 8+ characters
TEAM_PASSWORD=

# --- Client (Vite reads VITE_* only) ---
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=
# same value as SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=
