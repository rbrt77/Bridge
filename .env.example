# Copy to .env (root) — never commit .env
# --- Server ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# MOCK=1 => every route returns fixtures from server/src/mocks (no keys needed)
MOCK=1

OPENAI_API_KEY=
CHAT_MODEL=gpt-5-mini
BACKGROUND_MODEL=gpt-5-nano
RERANK_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
ELEVENLABS_API_KEY=
GITHUB_TOKEN=
DEMO_REPO=brightline-software/invoicing-service
SLACK_WEBHOOK_URL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Client (Vite reads VITE_* only) ---
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=
# same value as SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=
